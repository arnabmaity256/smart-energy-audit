{
  "uid": "energy-audit",
  "title": "Smart Energy Audit",
  "tags": [
    "iot",
    "energy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "tariff",
        "label": "Tariff (₹/kWh)",
        "query": "8",
        "current": {
          "text": "8",
          "value": "8"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Device",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-energy"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-energy"
          },
          "query": "from(bucket: \"energy\")\n  |> range(start: -30d, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_status\" and r._field == \"online\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
