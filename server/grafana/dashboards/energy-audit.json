        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-energy"
          },
          "query": "from(bucket: \"energy\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"power\" and r._field == \"power\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: \"power\"}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
