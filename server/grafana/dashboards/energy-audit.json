    {
      "id": 7,
      "type": "timeseries",
      "title": "Active Power",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-energy"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
